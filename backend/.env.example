# =====================================================================
# Vinay Bank backend configuration
# `npm run setup` copies this file to .env and replaces every
# __RANDOM_*__ placeholder with a freshly generated secret.
# All variables are validated at startup (apps/api/src/config).
# =====================================================================

# ---------- Application ----------
NODE_ENV=development
API_PORT=4000
LOG_LEVEL=debug
# Comma-separated browser origins allowed to call the API (the React dev server)
CORS_ORIGINS=http://localhost:5173
# Number of reverse proxies (e.g. nginx) in front of the API, used to read the real client IP
TRUST_PROXY=1

# ---------- MongoDB ----------
# Default: the local replica set started by `npm run dev` (scripts/mongo-dev.mjs).
# MongoDB Atlas example:
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster-host>/vinaybank?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27018/vinaybank?replicaSet=rs0

# ---------- Rate limiting (per client IP) ----------
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=300
# Stricter limit for login, registration and MFA endpoints (requests per minute per IP)
AUTH_THROTTLE_LIMIT=10

# ---------- Authentication ----------
# RS256 key pair generated by `npm run setup`. In containers you can pass the PEM
# contents directly with JWT_PRIVATE_KEY / JWT_PUBLIC_KEY (newlines escaped as \n).
JWT_PRIVATE_KEY_PATH=.secrets/jwt-private.pem
JWT_PUBLIC_KEY_PATH=.secrets/jwt-public.pem
JWT_ISSUER=vinaybank-api
JWT_AUDIENCE=vinaybank-web
# Short-lived access tokens (seconds); refresh tokens rotate on every use (days)
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
# Must be true when the site is served over HTTPS (production)
COOKIE_SECURE=false

# ---------- Data protection ----------
# AES-256-GCM key for field-level encryption of PII and card data (base64, 32 bytes).
# To rotate: move the current value to DATA_ENCRYPTION_KEY_PREVIOUS and set a new key.
DATA_ENCRYPTION_KEY=__RANDOM_BASE64_32__
# HMAC-SHA256 key for blind indexes (exact-match search on encrypted fields)
BLIND_INDEX_KEY=__RANDOM_BASE64_32__
# HMAC-SHA256 key for signed application tokens (transfer quotes, OTP hashes)
APP_HMAC_KEY=__RANDOM_BASE64_32__

# ---------- Banking rules ----------
# Transfers to a newly added beneficiary are capped at Rs 50,000 for this many hours
BENEFICIARY_COOLING_HOURS=24
# Customer transfers at or above this amount (in rupees) need a branch manager's approval
HIGH_VALUE_THRESHOLD_RUPEES=200000
# Simulated NEFT batch settlement delay (seconds)
NEFT_SETTLEMENT_SECONDS=60

# ---------- External integrations ----------
# Live IFSC directory (Razorpay, free and public) and ECB foreign exchange rates (Frankfurter)
IFSC_API_URL=https://ifsc.razorpay.com
FOREX_API_URL=https://api.frankfurter.dev/v1
EXTERNAL_HTTP_TIMEOUT_MS=4000

# ---------- Demo mode ----------
# When true, OTPs are delivered to the in-app notification centre (simulated SMS gateway)
DEMO_MODE=true
# Create demo users, accounts and transactions on first start (empty database only)
SEED_DEMO_DATA=true

# --- Cards and the ISO 8583 card network --------------------------------------
# First six digits of every Vinay Bank card (bank identification number)
CARD_BIN=652845
# Card switch: ISO 8583 over mutual TLS (acquirers and the ATM CLI connect here)
CARD_SWITCH_HOST=127.0.0.1
CARD_SWITCH_PORT=5800
# Issuer RPC: the switch calls the core banking API here (NestJS microservice, mutual TLS)
CORE_RPC_HOST=127.0.0.1
CORE_RPC_PORT=4001
CARD_NETWORK_TIMEOUT_MS=8000
# Zone PIN keys (double-length triple DES, hex). Acquirer zone: ATM/POS <-> switch.
CARD_ZPK_ACQUIRER=__RANDOM_HEX_16__
# Issuer zone: switch <-> core banking. The switch translates PIN blocks between zones.
CARD_ZPK_ISSUER=__RANDOM_HEX_16__
# Message authentication key (acquirer <-> switch), PIN verification key and card
# verification key (issuer only)
CARD_MAC_KEY=__RANDOM_BASE64_32__
CARD_PVK=__RANDOM_BASE64_32__
CARD_CVK=__RANDOM_BASE64_32__
# Mutual TLS material generated by "npm run setup"
TLS_CA_PATH=.secrets/tls/ca.pem
TLS_SERVER_CERT_PATH=.secrets/tls/server.pem
TLS_SERVER_KEY_PATH=.secrets/tls/server-key.pem
TLS_CLIENT_CERT_PATH=.secrets/tls/client.pem
TLS_CLIENT_KEY_PATH=.secrets/tls/client-key.pem

# --- SOAP partner service (WSDL at /soap/banking?wsdl) ----------------------------
# WS-Security UsernameToken credentials for a partner system (for example a
# corporate customer's ERP). The partner sees only this customer's accounts.
SOAP_USERNAME=erp-partner
SOAP_PASSWORD=__RANDOM_SECRET__
SOAP_CUSTOMER_EMAIL=priya@example.com

# --- General ledger (SQL) -------------------------------------------------------
# sqljs: SQLite in pure JavaScript, nothing to install (default). oracle: needs the
# "oracledb" package and the schema in database/oracle.
LEDGER_DB_TYPE=sqljs
LEDGER_SQLITE_PATH=.data/ledger.sqlite
LEDGER_ORACLE_CONNECT_STRING=
LEDGER_ORACLE_USER=
LEDGER_ORACLE_PASSWORD=

# --- Fraud risk engine (Java, Spring Boot: services/risk-engine) -----------------
# The API calls it through a circuit breaker and falls back to the same rules
# in-process if it is not running, so it is optional for development.
RISK_ENGINE_ENABLED=true
RISK_ENGINE_URL=http://127.0.0.1:8085
RISK_ENGINE_API_KEY=__RANDOM_SECRET__
RISK_ENGINE_TIMEOUT_MS=800
RISK_ENGINE_FAILURE_THRESHOLD=3
RISK_ENGINE_COOLDOWN_MS=30000
