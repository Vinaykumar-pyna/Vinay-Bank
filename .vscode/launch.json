{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "API: debug (nest start --debug)",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start:debug"],
      "console": "integratedTerminal",
      "autoAttachChildProcesses": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "API: attach to a running process (port 9229)",
      "type": "node",
      "request": "attach",
      "port": 9229,
      "restart": true,
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Jest: current backend test file",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}/backend",
      "program": "${workspaceFolder}/backend/node_modules/jest/bin/jest.js",
      "args": ["--runInBand", "${relativeFile}"],
      "console": "integratedTerminal"
    },
    {
      "name": "Web app: Chrome",
      "type": "chrome",
      "request": "launch",
      "url": "http://localhost:5173",
      "webRoot": "${workspaceFolder}/frontend/src"
    },
    {
      "name": "Risk engine: Spring Boot",
      "type": "java",
      "request": "launch",
      "mainClass": "com.vinaybank.risk.RiskEngineApplication",
      "projectName": "risk-engine",
      "envFile": "${workspaceFolder}/backend/.env",
      "vmArgs": "-Djdk.net.unixdomain.tmpdir=${env:SystemRoot}/Temp"
    }
  ]
}
