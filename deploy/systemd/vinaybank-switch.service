# /etc/systemd/system/vinaybank-switch.service
# ISO 8583 card switch (NestJS, mutual TLS on port 5800).
[Unit]
Description=Vinay Bank ISO 8583 card switch
After=network-online.target vinaybank-api.service
Wants=network-online.target

[Service]
Type=simple
User=vinaybank
Group=vinaybank
WorkingDirectory=/opt/vinaybank/backend
EnvironmentFile=/opt/vinaybank/backend/.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node dist/apps/card-switch/main.js
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
CapabilityBoundingSet=

[Install]
WantedBy=multi-user.target
